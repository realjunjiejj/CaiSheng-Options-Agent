[Unit]
Description=CaiSheng private paper-trading operator dashboard
Documentation=file:/opt/caisheng/docs/CLOUD_RUN_DEPLOYMENT.md
Wants=network-online.target caisheng-monitor.service
After=network-online.target caisheng-monitor.service
StartLimitIntervalSec=300
StartLimitBurst=10

[Service]
Type=simple
User=caisheng
Group=caisheng
WorkingDirectory=/opt/caisheng
Environment=CAISHENG_ENV_FILE=/etc/caisheng/caisheng.env
Environment=CAISHENG_BIND_HOST=127.0.0.1
Environment=PORT=8080
Environment=PATH=/opt/caisheng/.venv/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
ExecStart=/opt/caisheng/scripts/run_persistent_job.sh dashboard
Restart=always
RestartSec=5
TimeoutStopSec=30
KillSignal=SIGTERM
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=full
ReadWritePaths=/var/lib/caisheng /var/log/caisheng /opt/caisheng/data/runtime /opt/caisheng/data/evaluation

[Install]
WantedBy=multi-user.target
